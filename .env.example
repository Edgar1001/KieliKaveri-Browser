PORT=8787

# Use your computer's LAN IP when testing on a physical phone.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8787

# Create a key at https://platform.openai.com/api-keys and keep it server-side.
OPENAI_API_KEY=
# Optional: show current-month OpenAI Platform costs instead of the local estimate.
OPENAI_ADMIN_API_KEY=
# Optional: limit platform costs to one project. Leave empty for the organization total.
OPENAI_USAGE_PROJECT_ID=
OPENAI_MODEL=gpt-4.1
OPENAI_BUDGET_USD=5
OPENAI_INPUT_COST_PER_MILLION=2
OPENAI_CACHED_INPUT_COST_PER_MILLION=0.5
OPENAI_OUTPUT_COST_PER_MILLION=8

# Local speech model overrides
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8_float16