{
  "name": "languagetutor",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.22",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.18",
    "expo-file-system": "~57.0.7",
    "expo-linear-gradient": "~57.0.2",
    "expo-speech": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.46.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "concurrently": "^9.2.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "dev": "concurrently -k -n API,EXPO -c yellow,green \"npm run api\" \"npm start\"",
    "api": "scripts/run-local-api.sh",
    "api:start": "scripts/run-local-api.sh",
    "local:setup": "scripts/setup-local-ai.sh",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": ".venv/bin/python -m unittest discover -s local_server -p '*_test.py' -v"
  },
  "private": true
}
